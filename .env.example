COSMOS_ENDPOINT=https://<your-account>.privatelink.documents.azure.com:443/
COSMOS_DATABASE_NAME=sales
COSMOS_CONTAINER_NAME=products

AZURE_BLOB_ACCOUNT_URL=https://<your-account>.privatelink.blob.core.windows.net
AZURE_BLOB_CONTAINER_NAME=semiconductor-product-documents

SQL_CONNECTION_STRING=Driver={ODBC Driver 18 for SQL Server};Server=tcp:<server>.privatelink.database.windows.net,1433;Database=<database>;Encrypt=yes;TrustServerCertificate=no;Connection Timeout=30;Authentication=Active Directory Default

MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_MOUNT_PATH=

POLICY_MAX_OUTPUT_CHARS=12000
POLICY_RATE_LIMIT_PER_MINUTE=60
